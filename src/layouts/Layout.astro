---
import { Font } from 'astro:assets'
import '../styles/global.css'

interface Props {
  title?: string
  route?: string
}

const { title = 'Lucas Piputto', route = '/~' } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-nunito-sans" />
    <Font cssVariable="--font-bree-serif" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="py-4 bg-zinc-800">
      <div class="max-w-prose mx-auto px-6">
        <span class="font-mono">
          {route}
        </span>
      </div>
    </header>
    <div class="max-w-prose mx-auto py-8 px-6">
      <slot />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
