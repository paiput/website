---
import { Font } from 'astro:assets'
import '../styles/global.css'

interface Props {
  title?: string
  withHeader?: boolean
  padded?: boolean
}

const {
  title = 'Lucas Piputto',
  withHeader = true,
  padded = true,
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-geist-mono" />
    <Font cssVariable="--font-inter-tight" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    {
      withHeader && (
        <header class="bg-foreground text-background">
          <nav>
            <ul class="flex items-center justify-between px-6 md:justify-center gap-4 md:gap-32 flex-wrap">
              <li>
                <a
                  href="/projects"
                  class="font-geist-mono text-xs md:text-base"
                >
                  Projects
                </a>
              </li>
              <li>
                <a
                  href="/"
                  class="block uppercase text-3xl leading-6 font-inter-tight font-bold -mb-0.5 select-none md:text-6xl md:leading-11.5"
                >
                  Lucas
                  <br />
                  Piputto
                </a>
              </li>
              <li>
                <a href="/now" class="font-geist-mono text-xs md:text-base">
                  Now
                </a>
              </li>
            </ul>
          </nav>
        </header>
      )
    }
    <main class={padded ? 'max-w-7xl mx-auto py-8 px-6' : null}>
      <slot />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
