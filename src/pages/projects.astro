---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'

const projects = await getCollection('projects')
---

<Layout>
  <div>
    <main>
      <section>
        <h1 class="text-5xl mt-9 mb-6 font-geist font-semibold">Projects</h1>
        <ul class="">
          {
            projects.map(({ data: project, body, id }, index) => (
              <li class="py-8 border-t border-secondary-foreground/20 md:flex">
                <span class="font-geist md:w-full max-w-24 text-xl md:text-4xl text-secondary-foreground">
                  0{index + 1}
                </span>
                <div class="w-full">
                  <div class="flex items-center justify-between gap-4">
                    <h3 class="text-2xl font-geist">
                      {!!body ? (
                        <a href={`/${id}`} class="group">
                          {project.name}{' '}
                          <span class="text-lg mb-1 ease-out transition-[padding] duration-300 group-hover:pl-1 text-secondary-foreground">
                            →
                          </span>
                        </a>
                      ) : (
                        project.name
                      )}
                    </h3>
                    <span class="text-sm pt-0.5 text-secondary-foreground font-geist-mono">
                      {project.year}
                    </span>
                  </div>
                  <p class="text-sm text-secondary-foreground text-justify max-w-2xl mt-4">
                    {project.description}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
  </div>
</Layout>
