---
import * as now from '../content/now/now.md'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Now - Lucas Piputto" route="/now">
  <article class="now-content">
    <h1>Now</h1>

    <now.Content />
  </article>
</Layout>

<style>
  .now-content :global(p) {
    margin-top: 1rem;
  }

  .now-content :global(ul) {
    margin-top: 1rem;
    padding-left: 1.5rem;
    list-style-type: disc;
  }

  .now-content :global(li) {
    margin-top: 0.5rem;
  }

  .now-content :global(a) {
    color: var(--color-link);
  }
</style>
