---
import Layout from '../layouts/Layout.astro'
---

<Layout title="404 - Lucas Piputto" withHeader={false} padded={false}>
  <div class="min-h-screen flex items-center justify-center px-6 py-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:gap-32">
      <h1
        class="font-inter-tight text-8xl leading-none font-bold uppercase select-none md:text-9xl"
      >
        404
      </h1>

      <div class="flex max-w-[22ch] flex-col gap-8">
        <p class="text-sm/tight md:text-base/tight">
          Hello, Dolly! The page you are looking for does not exist 🎶.
        </p>

        <nav aria-label="404 recovery">
          <ul class="text-sm md:text-base">
            <li>
              <a href="/" class="font-geist-mono group"
                >Home <span
                  class="ease-out transition-[padding] duration-300 group-hover:pl-1 group-active:text-secondary-foreground"
                  >→</span
                ></a
              >
            </li>
            <li>
              <a href="/projects" class="font-geist-mono group"
                >Projects <span
                  class="ease-out transition-[padding] duration-300 group-hover:pl-1 group-active:text-secondary-foreground"
                  >→</span
                ></a
              >
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</Layout>
