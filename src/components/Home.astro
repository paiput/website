---
import { getCollection } from 'astro:content'
import { GitHubIcon, LinkedInIcon, XIcon, LinkIcon } from './icons'

const projects = await getCollection('projects')
---

<div>
  <main>
    <section>
      <div class="flex items-center gap-4 justify-between flex-col sm:flex-row">
        <h1>Lucas Piputto</h1>
        <ul class="flex gap-4">
          <li>
            <a
              href="https://github.com/paiput"
              target="_blank"
              rel="noopener noreferrer"
            >
              <GitHubIcon />
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/lucaspiputto/"
              target="_blank"
              rel="noopener noreferrer"
            >
              <LinkedInIcon />
            </a>
          </li>
          <li>
            <a
              href="https://x.com/paiput_"
              target="_blank"
              rel="noopener noreferrer"
            >
              <XIcon />
            </a>
          </li>
        </ul>
      </div>
      <div class="mt-6">
        <p>
          Building at <a
            class="text-link underline"
            href="https://paisanos.io"
            target="_blank">Paisanos</a
          > & learning about computers at UBA
        </p>
      </div>
    </section>
    <section>
      <h2 class="text-2xl mt-9 mb-6">Projects</h2>
      <ul class="space-y-6">
        {
          projects.map(({ data: project }) => (
            <li>
              <div class="flex items-center gap-4 mb-2">
                <h3 class="text-lg">{project.name}</h3>
                {!!(project.url || project.repository) && (
                  <span class="text-secondary-foreground">/</span>
                )}
                {project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <LinkIcon size={16} />
                  </a>
                )}
                {project.repository && (
                  <a
                    href={project.repository}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <GitHubIcon size={16} />
                  </a>
                )}
              </div>
              <p class="text-sm text-secondary-foreground text-justify">
                {project.description}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</div>
